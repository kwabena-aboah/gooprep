SECRET_KEY=your-50-char-secret-key-here
DEBUG=False
ALLOWED_HOSTS=api.gooprep.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://gooprep.com,https://www.gooprep.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://gooprep.com,https://www.gooprep.com,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
DATABASE_URL=postgresql://user:password@host:5432/gooprep
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.xxxxxxxx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gooprep.com
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
BBB_URL=https://bbb.yourdomain.com/bigbluebutton/api/
BBB_KEY=your-bbb-shared-secret
# BBB_SECRET is supported for backwards compatibility.
OPENAI_API_KEY=sk-proj-xxxxxxxx
WHATSAPP_API_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
PLATFORM_COMMISSION=0.20
MIN_PAYOUT=50.00
FRONTEND_URL=
