{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/django-admin/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/tinymce/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/static/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/media/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/webhooks/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}