{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/django-admin/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/tinymce/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/media/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/((?!api/|django-admin/|tinymce/|static/|media/|webhooks/).*)",
      "destination": "/index.html"
    }
  ]
}