{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/django-admin/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/tinymce/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/media/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/webhooks/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}